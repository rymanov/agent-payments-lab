{
  "name": "agent-payments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mandate checker between an AI agent and x402 payments. Base Sepolia testnet only.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "wallet:new": "tsx src/scripts/new-wallet.ts",
    "wallet:balance": "tsx src/scripts/balance.ts",
    "service": "tsx src/service/server.ts",
    "checker": "tsx src/checker/main.ts",
    "agent": "tsx src/agent/run-sandboxed.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:live": "tsx tests/live/live-run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@x402/core": "2.30.0",
    "@x402/evm": "2.30.0",
    "@x402/express": "2.30.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "opentimestamps": "0.4.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
